#!/usr/bin/env bash
# AppImage entry point: starts the frozen Tk launcher. The launcher picks the game folder, runs
# run.py and handles --play (the game without a window, for Steam and shortcuts).
# Usage: wipeout-x86_64.AppImage [--play]
set -euo pipefail
here=$(dirname -- "$(readlink -f -- "$0")")
share=$here/usr/share/wipeout_oc

export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
source "$share/scripts/environment.sh"
wipeout_oc_anchor_config
wipeout_oc_select_data_directory
mkdir -p "${WIPEOUT_OC_DATA_DIR:-.}"

cd -- "$share"
exec "$share/wipeout_oc-launcher" "$@"
